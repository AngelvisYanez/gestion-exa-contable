# Environment
# Zona horaria del sistema: America/Guayaquil (Ecuador). También se fija en instrumentation.ts.
TZ=America/Guayaquil

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAMES=exa,servicios
DATABASE_URL="mysql://root@127.0.0.1:3306/exa"
# Pool Prisma por BD (default 2). Con exa+servicios ≈ 4 conexiones máx.
DATABASE_CONNECTION_LIMIT=2
DATABASE_POOL_TIMEOUT=10
# 1 = duplicar telemetría en la otra BD (gasta más conexiones). Default off.
TELEMETRIA_MIRROR=0

# Tareas: TORRES CARRION FRANCISCO SAMUEL [MATRIZ] (Emp_Cod=96, Dat_Dis=exa)
TASKS_DB_DIS=exa
TASKS_EMP_COD=96

CAPTURES_DIR=capturas
# Logs de error EXA (carpeta o archivos; varios con ;)
EXA_ERROR_LOG=../exa-ofsercont/logs
EXA_MONITOR_API_KEY=

# Auth panel (usuarios en BD exa)
AUTH_SECRET=cambia-este-secreto
# Opcional: override de usuarios JSON
# AUTH_USERS_JSON=

# Briefs de desarrollo (MD + PDF en docs/ del proyecto gestion)
DOCS_DIR=docs
# Ruta absoluta o relativa al codigo EXA OFSERCONT en el servidor
EXA_OFSERCONT_ROOT=../exa-ofsercont
# URL publica del panel (para adjuntar PDF por UltraMsg en fase 2)
PUBLIC_APP_URL=https://gestion.exacontable.com

# Gemini 3 (generacion de briefs). Nunca commitear la clave real.
BRIEF_LLM_ENABLED=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# PDF diseno EXA (ReportLab). Requiere Python 3 + reportlab en el PATH.
# BRIEF_PDF_PYTHON=py

# WhatsApp UltraMsg (misma instancia que exa-ofsercont/relavera). Por defecto OFF.
WHATSAPP_ENABLED=0
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
